# Kestra secrets: los valores SECRET_* deben ir codificados en base64
# echo -n "tu_token" | base64
SECRET_KAGGLE_API_TOKEN=your_kaggle_api_token_base64_here
# Llave privada de Snowflake: base64 -i /ruta/a/rsa_key.p8 | tr -d '\n'
SECRET_SNOWFLAKE_PRIVATE_KEY=your_snowflake_private_key_base64_here

# PostgreSQL configuration
POSTGRES_DB=your_postgres_db_here
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here

# Kestra configuration
# KESTRA_USER debe ser un email válido; KESTRA_PASSWORD mínimo 8 caracteres, con mayúscula y número
KESTRA_USER=admin@example.com
KESTRA_PASSWORD=your_kestra_password_here

# Snowflake configuration
SNOWFLAKE_ACCOUNT=your_snowflake_account_here
SNOWFLAKE_USER=M5_PIPELINE_USER
SNOWFLAKE_ROLE=M5_PIPELINE
SNOWFLAKE_WAREHOUSE=M5_WAREHOUSE
SNOWFLAKE_DATABASE=M5
# SNOWFLAKE_PRIVATE_KEY_PATH debe ser la ruta absoluta a tu archivo de clave privada
SNOWFLAKE_PRIVATE_KEY_PATH=/ruta/absoluta/a/rsa_key.p8

